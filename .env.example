# Supabase Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Application Configuration
APP_PASSWORD=your_shared_password_here
SECRET_KEY=generate_a_random_secret_key_here

# Optional: Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# CORS: comma-separated list of allowed frontend origins
# Example for GitHub Pages:
# FRONTEND_ORIGINS=https://yourusername.github.io
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Session cookie settings
# Use None/True in production when frontend and backend are on different domains.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
